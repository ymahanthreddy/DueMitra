# ====================================================================
# DueMitra ERP — Environment Variables & Cloud Integrations Example
# Copy this file to .env and provide your production credentials
# ====================================================================

# 1. Express Backend Server Configuration
PORT=3001

# 2. Resend Transactional Email API (https://resend.com)
# Used for automated daily reminder dispatch and transactional invoices
RESEND_API_KEY=re_your_resend_api_key_here

# 3. Google Gemini Vision API (https://ai.google.dev)
# Used by the server endpoint /api/ocr-invoice to scan paper and PDF invoices
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# 4. Supabase Cloud Database (PostgreSQL)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 5. ElevenLabs Conversational AI Voice Integration
VITE_ELEVENLABS_API_KEY=sk_your_elevenlabs_key_here

# 6. Twilio SMS & Voice Gateway (Optional)
VITE_TWILIO_ACCOUNT_SID=AC_your_account_sid
VITE_TWILIO_AUTH_TOKEN=your_auth_token
VITE_TWILIO_PHONE_NUMBER=+1234567890

